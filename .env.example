# Ampolin AI Trading Agent - Environment Variables

# DhanHQ API Credentials (https://dhanhq.co)
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_jwt_token_here

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Alerts (via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Risk Management
MAX_ACCOUNT_RISK_PCT=0.01
DEFAULT_ACCOUNT_CAPITAL=100000.0

# Strategy Defaults
DEFAULT_TIMEFRAME=1d
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_MIN=48.0
RSI_MAX=68.0
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.5
TP_RISK_MULTIPLIER=2.0
MIN_WIN_RATE=0.45
MIN_EXPECTANCY=0.0
BACKTEST_LOOKBACK_DAYS=90
